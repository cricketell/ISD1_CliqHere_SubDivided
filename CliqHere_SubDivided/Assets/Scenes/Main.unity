--- !u!114 &718482051
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 718482047}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9bbe0ab7c265fb44dbe423a182d43e5b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  noteText: "The crew are getting reckless, they're too caught up in their own conflicts
    to realise it. I have a terrible feeling that something bad is going to happen,
    they need to be more careful and focus. \n\nI do understand however, I'm not
    sure if we should even keep going... The only reason I've not fallen into the
    clash is because I must stay strong as the captain, otherwise we could face mutiny...
    \n\nI'm unsure how much longer I can hold out though. What we are doing is not
    right."
  notePanel: {fileID: 704764223}
  noteTextUI: {fileID: 299820757}
  escHintText: {fileID: 71781803}
