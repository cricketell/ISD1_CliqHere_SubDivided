--- !u!114 &1353215238
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1353215234}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9bbe0ab7c265fb44dbe423a182d43e5b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  noteText: "We\u2019ve already been frightened about that THING and now I hear someone
    harping on\nabout it getting BIGGER?! And we\u2019re supposed to be the scientists.
    We shouldn\u2019t\u2019ve started this whole thing in the first place!! I can\u2019t
    take it anymore. Surrounded by these people who still think what we\u2019re doing
    is right?? We wanted to create the so called \u2018ultimate life form\u2019 whatever
    that means... But we\u2019re just gonna end up losing our own lives! Calling
    it now whilst I\u2019m still sane enough to even consider the morality of this
    whole wreck.\n\nWho do we think we are PLAYING GOD??"
  notePanel: {fileID: 704764223}
  noteTextUI: {fileID: 299820757}
  escHintText: {fileID: 71781803}
