--- !u!114 &2122287354
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2122287351}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9bbe0ab7c265fb44dbe423a182d43e5b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  noteText: "I\u2019m getting a little worried... Everyone\u2019s fighting and no
    one\u2019s paying attention to the\nthing we created. Some are wanting to go
    as far as forcing the Captain to take the\nship back up to surface and abort
    completely! Honestly, I don\u2019t blame them, I just want to get out. Everyone\u2019s
    getting on at each other, me included. We\u2019ve been\ncouped up in this godforsaken
    submarine for far too long, and now we have to share\nwith that too!? I want
    it gone. I want this whole mission gone. It\u2019s not worth it..."
